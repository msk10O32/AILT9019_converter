# Ignore rules for the hkd2usd project. Everything here is generated locally,
# so nothing in this list belongs in version control.

# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo

# Build / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test and coverage output
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Tooling caches
.mypy_cache/
.ruff_cache/
.tox/

# Jupyter
.ipynb_checkpoints/

# Local secrets and per-machine overrides. The app needs no configuration to
# run, so a local settings module is only ever a developer's own scratch file.
.env
*.local
local_settings.py

# Django. db.sqlite3 is created by `manage.py migrate` and holds nothing but
# Django's own tables and the session history.
*.sqlite3
*.sqlite3-journal
/staticfiles/
/media/
*.log

# Editors and OS cruft
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
